{
  "project_id": "project_example",
  "repo_ref": "github:example-org/example-app#main",
  "target_environment": "staging",
  "mode": "deep",
  "scope": {
    "kind": "entire_repository"
  },
  "crosscuts": {
    "SYSTEM_INTEGRATION_CLOSURE": "auto",
    "ARCHITECTURAL_RESILIENCE": "auto",
